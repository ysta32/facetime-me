{
  "name": "facetime-me",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "livekit-server-sdk": "^2.13.0",
    "zod": "^3.25.76",
    "@trychert/facetime": "0.1.0-beta.19"
